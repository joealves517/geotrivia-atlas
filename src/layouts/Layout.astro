---
import '~/assets/styles/tailwind.css';

import { Font } from 'astro:assets';

import { I18N } from 'astrowind:config';

import CommonMeta from '~/components/common/CommonMeta.astro';
import Favicons from '~/components/Favicons.astro';
import CustomStyles from '~/components/CustomStyles.astro';
import ApplyColorMode from '~/components/common/ApplyColorMode.astro';
import ApplyLanguage from '~/components/common/ApplyLanguage.astro';
import Metadata from '~/components/common/Metadata.astro';
import SiteVerification from '~/components/common/SiteVerification.astro';
import Analytics from '~/components/common/Analytics.astro';
import Intersect from '~/components/common/Intersect.astro';

// Comment the line below to disable View Transitions
import { ClientRouter } from 'astro:transitions';

import type { MetaData as MetaDataType } from '~/types';

export interface Props {
  metadata?: MetaDataType;
  language?: string;
  textDirection?: string;
}

const { metadata = {}, language: propLang, textDirection: propDir } = Astro.props;
const { language: defaultLang, textDirection: defaultDir } = I18N;
const activeLang = propLang || metadata?.language || defaultLang || 'en';
const activeDir = propDir || metadata?.textDirection || (activeLang === 'ar' ? 'rtl' : defaultDir || 'ltr');
---

<!doctype html>
<html lang={activeLang} dir={activeDir} class="2xl:text-[20px]">
  <head>
    <CommonMeta />
    <Favicons />
    <Font cssVariable="--font-inter" preload />
    <CustomStyles />
    <ApplyColorMode />
    <ApplyLanguage />
    <Metadata {...metadata} />
    <SiteVerification />
    <Analytics />

    <link rel="preconnect" href="https://images.unsplash.com" />

    <!-- Comment the line below to disable View Transitions -->
    <ClientRouter fallback="swap" />

    <!-- Extra head content from pages: structured data, rel=prev/next, … -->
    <slot name="head" />
  </head>

  <body class="antialiased text-default bg-page tracking-tight min-h-screen flex flex-col">
    <slot />

    <Intersect />
  </body>
</html>
