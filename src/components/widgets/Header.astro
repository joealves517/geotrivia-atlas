---
import { NavbarFloating } from '~/components/navbar/navbar-floating';

export interface Props {
  id?: string;
  isSticky?: boolean;
  isDark?: boolean;
  isFullWidth?: boolean;
  position?: string;
  showToggleTheme?: boolean;
  showRssFeed?: boolean;
  actions?: Array<unknown>;
  links?: Array<unknown>;
  [key: string]: unknown;
}

const {
  isSticky = true,
  id = 'header',
} = Astro.props;
---

<div
  id={id}
  class:list={[
    { 'sticky top-0 z-50': isSticky, relative: !isSticky },
    'w-full bg-white/90 dark:bg-[#1a1a1c]/95 backdrop-blur-md shadow-xs',
  ]}
>
  <div class="w-full max-w-7xl mx-auto px-4 sm:px-6 lg:px-8">
    <NavbarFloating client:load />
  </div>
</div>

